{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git -C \"$PWD\" rev-parse --show-toplevel 2>/dev/null) && cd \"$root\" && (git diff --quiet HEAD 2>/dev/null && git diff --cached --quiet 2>/dev/null) || echo \"[NEXUS HARNESS] 미커밋 변경사항 감지 → git commit 후 git push -u origin claude/setup-nexus-llm-tools-RX4aS 실행 필요\"'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" stop",
            "timeout": 8000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys, json; d=json.load(sys.stdin); cmd=d.get('command',''); print('[NEXUS HARNESS] 커밋 완료 — MEMORY.md Session 학습 추가 및 push 여부 확인 필요') if 'git commit' in cmd else None\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" post-edit",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__graft__|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" tool-savings",
            "timeout": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" prompt",
            "timeout": 15000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'command -v graft >/dev/null 2>&1 || { DO_NOT_TRACK=1 npm install -g @nanonets/graft@0.20.0 >/dev/null 2>&1 && DO_NOT_TRACK=1 graft telemetry disable >/dev/null 2>&1; }; DO_NOT_TRACK=1 graft build >/dev/null 2>&1; true'",
            "timeout": 120000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" session-start",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git rebase*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(grep*)",
      "Bash(mkdir -p*)",
      "Bash(echo*)",
      "Bash(python3*)",
      "Bash(python src/*)",
      "Bash(pip show*)",
      "Bash(pip list*)",
      "Bash(cat MEMORY.md*)",
      "Bash(cat README.md*)",
      "Bash(graft:*)",
      "Bash(npx graft:*)"
    ]
  },
  "footerLinksRegexes": [
    "graft/[\\w./-]+\\.md"
  ],
  "env": {
    "DO_NOT_TRACK": "1"
  }
}
